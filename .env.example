# Required: your Claude API key (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=sk-ant-...

# Recommended: Supabase (run supabase/schema.sql in the SQL editor once; the Vercel Supabase
# integration adds these automatically). Without it the app still works, but saves stay in
# each visitor's browser. Use the service-role key; it is only ever read on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Owner mode: open https://your-site/?owner=<this value> once in your own browser.
# Owner mode lets you add generated questions to the shared bank and receive "explanation seems off" reports.
OWNER_KEY=change-me-to-a-long-random-string

# Optional: require an access code before the site will call Claude (stops strangers spending your credits).
# Visitors get prompted once; or share https://your-site/?access=<code>.
ACCESS_CODE=

# Optional tuning
SAMPLE_PER_HOUR=150
MODEL_DEFAULT=claude-sonnet-5-5
MODEL_COMPLEX=claude-opus-5-5
MAX_TOKENS=8192
